{
  "name": "nextjs-todo-list-example",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "next dev",
    "dev:local": "tsx scripts/local-postgres/cli.ts dev",
    "local:postgres": "tsx scripts/local-postgres/cli.ts",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:pipeline": "vitest run src/test/environment src/test/pipeline scripts/deploy/preview/core.test.ts scripts/deploy/preview/vercel.test.ts scripts/deploy/production",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cross-browser": "tsx scripts/playwright-local/run.ts --cross-browser",
    "better-auth-mcp": "tsx scripts/better-auth-mcp/cli.ts",
    "environment:inspect": "tsx scripts/environment/cli.ts inspect",
    "neon:development": "tsx scripts/neon-development/cli.ts",
    "logging": "tsx scripts/logging/cli.ts",
    "preview": "tsx scripts/deploy/preview/cli.ts",
    "release": "tsx scripts/deploy/production/cli.ts",
    "sanity:smoke": "tsx scripts/verify-sanity.ts",
    "neon:performance": "node scripts/verify-neon-performance/cli.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.15.0",
    "@sentry/core": "11.0.0",
    "@vercel/functions": "^3.9.8",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.15.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.20",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agent-browser": "0.38.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
